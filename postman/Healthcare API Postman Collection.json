    {
      "name": "GET /api/metrics",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "  pm.response.to.have.status(200)",
              "})",
              "pm.test('System metrics and hospital counts are present', function () {",
              "  const data = pm.response.json()",
              "  pm.expect(data.uptime).to.be.at.least(0)",
              "  pm.expect(data.memory).to.be.above(0)",
              "  pm.expect(data.status).to.be.oneOf(['warming-up', 'healthy', 'steady'])",
              "  for (const name of ['doctors', 'patients', 'appointments']) {",
              "    pm.expect(Number.isInteger(data.hospital[name])).to.equal(true)",
              "    pm.expect(data.hospital[name]).to.be.at.least(0)",
              "  }",
              "})"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/metrics",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "metrics"
          ]
